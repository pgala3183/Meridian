# Meridian local development environment
# Copy to .env and fill in real values. Never commit .env.
# Production MUST use Google Secret Manager — API keys in env vars are rejected.

MERIDIAN_ENV=local
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Vertex model your project has access to (varies by project — e.g. gemini-2.5-flash)
MERIDIAN_GEMINI_MODEL=gemini-2.5-flash

# Storage: local | gcs
MERIDIAN_STORAGE_BACKEND=local
MERIDIAN_LOCAL_STORAGE=.meridian-data/objects
MERIDIAN_GCS_BUCKET=
MERIDIAN_GCS_PREFIX=meridian

# Job store: memory | firestore
MERIDIAN_JOB_STORE=memory

# Pub/Sub topic path (empty = in-memory queue for local)
MERIDIAN_PUBSUB_TOPIC=

# Optional non-Gemini providers (leave blank when using Vertex Gemini only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional Redis (rate limit + warm cache) — leave unset to use in-memory limiter
# REDIS_URL=redis://localhost:6379/0
MERIDIAN_RL_CAPACITY=30
MERIDIAN_RL_REFILL=0.5
