# Meridian local development environment
# Copy to .env and fill in real values. Never commit .env.
# Production MUST use Google Secret Manager — API keys in env vars are rejected.

MERIDIAN_ENV=local

# GCP project (also required in production via Secret Manager / ADC)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Provider keys — local .env only. Use placeholders below until you add real keys.
# Startup refuses to boot if these still look like placeholders when required.
OPENAI_API_KEY=sk-your-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Optional Redis (warm cache tier)
REDIS_URL=redis://localhost:6379/0
