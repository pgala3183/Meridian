# Copy to terraform.tfvars (do not commit secrets).
project_id         = "your-gcp-project-id"
region             = "us-central1"
name_prefix        = "meridian"
api_image          = "us-central1-docker.pkg.dev/your-gcp-project-id/meridian/api:latest"
worker_image       = "us-central1-docker.pkg.dev/your-gcp-project-id/meridian/worker:latest"
web_image          = "us-central1-docker.pkg.dev/your-gcp-project-id/meridian/web:latest"
billing_account    = "XXXXXX-XXXXXX-XXXXXX" # required for budget alerts
monthly_budget_usd = 50
budget_alert_email = "you@example.com"
enable_uptime_checks = true
